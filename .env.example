# GeonicDB API の URL
# 開発時: Vite proxy 経由のためデフォルト空文字（同一オリジン）
# GitHub Pages デプロイ時: デプロイ先の GeonicDB URL を設定（末尾スラッシュなし）
# fork 利用者はリポジトリ変数 GEONICDB_URL で上書き可能（deploy-pages.yml 参照）
VITE_GEONICDB_URL=https://demo.geonicdb.com/api

# Geolonia Maps の API キー
# https://geolonia.com/ から取得してください
VITE_GEOLONIA_API_KEY=YOUR-API-KEY
