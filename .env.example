# GeonicDB API の URL（匿名・直接アクセス）
VITE_GEONICDB_URL=https://geonicdb.geolonia.com

# GeonicDB テナント名（Fiware-Service ヘッダ）
VITE_GEONICDB_TENANT=demo

# Geolonia Maps の API キー
# https://geolonia.com/ から取得してください
VITE_GEOLONIA_API_KEY=YOUR-API-KEY

# デモモード（true: 読み取り専用バナーを表示）
VITE_DEMO_MODE=true

# ── Seed スクリプト (npm run seed) ───────────────────────────
# 自テナントへ板橋区公共施設データを投入する場合に設定してください。
# demo テナント (geonicdb.geolonia.com) は匿名・読み取り専用のため投入できません。
GEONICDB_SEED_URL=https://your-geonicdb-instance.example.com
GEONICDB_SEED_TENANT=your-tenant
GEONICDB_SEED_TOKEN=your-token
